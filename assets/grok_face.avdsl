--
-- Grok Bot pill face. All geometry, timing and expression blending live in
-- C++ (main/pill_face.hpp): every frame it writes a display list of 28
-- capsule segments into the face-parameter window, in 320 x 240 design
-- coordinates with RGB565 colours already resolved from the palette. This
-- file only rasterizes them, so the same bytecode scales to every panel
-- through tx() / ty() and canvas_scale.
--
-- Segment N = segN_ax, segN_ay, segN_bx, segN_by, segN_r, segN_col:
-- a capsule from A to B with radius r; r == 0 skips the slot. segN_col is
-- RGB565 plus end flags above bit 16: +65536 drops the circle at A,
-- +131072 drops the one at B (both = a rectangle; the Done arches use
-- them). Slots draw in order: satellites, body, eye halves, arches, then
-- decorations.

fn seg(ax, ay, bx, by, r, col)
  if r <= 0 then
    return
  end
  let flags = floor(col / 65536)
  let c = col - flags * 65536
  let flat_b = floor(flags / 2)
  let flat_a = flags - flat_b * 2
  let x0 = tx(ax)
  let y0 = ty(ay)
  let x1 = tx(bx)
  let y1 = ty(by)
  let rad = r * canvas_scale
  if flat_a == 0 then
    fill_circle(round(x0), round(y0), round(rad), c)
  end
  let dx = x1 - x0
  let dy = y1 - y0
  let len = sqrt(dx * dx + dy * dy)
  if len < 0.5 then
    return
  end
  -- Half a pixel wider than the end circles so the quad never leaves a seam.
  let nx = 0 - dy / len * (rad + 0.5)
  let ny = dx / len * (rad + 0.5)
  fill_triangle(round(x0 + nx), round(y0 + ny), round(x0 - nx), round(y0 - ny), round(x1 + nx), round(y1 + ny), c)
  fill_triangle(round(x0 - nx), round(y0 - ny), round(x1 - nx), round(y1 - ny), round(x1 + nx), round(y1 + ny), c)
  if flat_b == 0 then
    fill_circle(round(x1), round(y1), round(rad), c)
  end
end

fn draw()
  fill_rect(0, 0, canvas_w, canvas_h, background)
  begin_group(0, 0, canvas_w, canvas_h)
  seg(seg0_ax, seg0_ay, seg0_bx, seg0_by, seg0_r, seg0_col)
  seg(seg1_ax, seg1_ay, seg1_bx, seg1_by, seg1_r, seg1_col)
  seg(seg2_ax, seg2_ay, seg2_bx, seg2_by, seg2_r, seg2_col)
  seg(seg3_ax, seg3_ay, seg3_bx, seg3_by, seg3_r, seg3_col)
  seg(seg4_ax, seg4_ay, seg4_bx, seg4_by, seg4_r, seg4_col)
  seg(seg5_ax, seg5_ay, seg5_bx, seg5_by, seg5_r, seg5_col)
  seg(seg6_ax, seg6_ay, seg6_bx, seg6_by, seg6_r, seg6_col)
  seg(seg7_ax, seg7_ay, seg7_bx, seg7_by, seg7_r, seg7_col)
  seg(seg8_ax, seg8_ay, seg8_bx, seg8_by, seg8_r, seg8_col)
  seg(seg9_ax, seg9_ay, seg9_bx, seg9_by, seg9_r, seg9_col)
  seg(seg10_ax, seg10_ay, seg10_bx, seg10_by, seg10_r, seg10_col)
  seg(seg11_ax, seg11_ay, seg11_bx, seg11_by, seg11_r, seg11_col)
  seg(seg12_ax, seg12_ay, seg12_bx, seg12_by, seg12_r, seg12_col)
  seg(seg13_ax, seg13_ay, seg13_bx, seg13_by, seg13_r, seg13_col)
  seg(seg14_ax, seg14_ay, seg14_bx, seg14_by, seg14_r, seg14_col)
  seg(seg15_ax, seg15_ay, seg15_bx, seg15_by, seg15_r, seg15_col)
  seg(seg16_ax, seg16_ay, seg16_bx, seg16_by, seg16_r, seg16_col)
  seg(seg17_ax, seg17_ay, seg17_bx, seg17_by, seg17_r, seg17_col)
  seg(seg18_ax, seg18_ay, seg18_bx, seg18_by, seg18_r, seg18_col)
  seg(seg19_ax, seg19_ay, seg19_bx, seg19_by, seg19_r, seg19_col)
  seg(seg20_ax, seg20_ay, seg20_bx, seg20_by, seg20_r, seg20_col)
  seg(seg21_ax, seg21_ay, seg21_bx, seg21_by, seg21_r, seg21_col)
  seg(seg22_ax, seg22_ay, seg22_bx, seg22_by, seg22_r, seg22_col)
  seg(seg23_ax, seg23_ay, seg23_bx, seg23_by, seg23_r, seg23_col)
  seg(seg24_ax, seg24_ay, seg24_bx, seg24_by, seg24_r, seg24_col)
  seg(seg25_ax, seg25_ay, seg25_bx, seg25_by, seg25_r, seg25_col)
  seg(seg26_ax, seg26_ay, seg26_bx, seg26_by, seg26_r, seg26_col)
  seg(seg27_ax, seg27_ay, seg27_bx, seg27_by, seg27_r, seg27_col)
  end_group()
end
